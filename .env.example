# Copy this file to .env and fill in the values. Never commit .env.
# Every piece of data processed by this project is synthetic.

# Enrichment backend: baseline | local | anthropic
AML_ENRICHER=baseline

# anthropic backend
ANTHROPIC_API_KEY=
AML_ANTHROPIC_MODEL=claude-opus-5-5

# local backend (Ollama)
AML_OLLAMA_URL=http://localhost:11434
AML_OLLAMA_MODEL=

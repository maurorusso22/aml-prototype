# Copy this file to .env and fill in the values. Never commit .env.
# Every piece of data processed by this project is synthetic.

# Enrichment backend, in order of preference: local | anthropic | baseline
AML_ENRICHER=local

# local backend (Ollama); the model defaults to llama3.1:8b when left empty
AML_OLLAMA_URL=http://localhost:11434
AML_OLLAMA_MODEL=

# anthropic backend
ANTHROPIC_API_KEY=
AML_ANTHROPIC_MODEL=claude-haiku-5-5
